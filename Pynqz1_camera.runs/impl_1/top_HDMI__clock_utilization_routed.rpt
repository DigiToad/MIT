resize_pblock [get_pblocks {CLKAG_hdmi/sig_gen/CLK}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "hdmi/sig_gen/BUFG_clk_pix_0" driven by instance "hdmi/sig_gen/BUFG_clk_pix" located at site "BUFGCTRL_X0Y0"
